package i18n

import (
	"errors"
	"fmt"
	"strings"

	"github.com/go-playground/validator/v10"

)

// Translate 用于将校验错误按指定语言翻译后返回。
func Translate(err error, lang string) error {
	if err == nil {
		return nil
	}

	var validationErrs validator.ValidationErrors
	if !errors.As(err, &validationErrs) {
		return err
	}

	messages := make([]string, 0, len(validationErrs))
	for _, fieldErr := range validationErrs {
		messages = append(messages, translateFieldError(fieldErr, lang))
	}

	return errors.New(strings.Join(messages, "; "))
}

func translateFieldError(fieldErr validator.FieldError, lang string) string {
	data := map[string]any{
		"Field": fieldErr.Field(),
		"Param": fieldErr.Param(),
		"Value": fmt.Sprint(fieldErr.Value()),
	}

	messageID := "validate." + fieldErr.Tag()
	message := Localize(lang, messageID, data)
	if message == messageID {
		return fmt.Sprintf("%s 校验失败(%s)", fieldErr.Field(), fieldErr.Tag())
	}

	return message
}
